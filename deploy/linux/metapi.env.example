# 复制到 /etc/metapi/metapi.env，权限设为 root:root 0600；真实密钥不要提交到 Git。
NODE_ENV=production
HOST=192.168.3.3
PORT=4000
TZ=Asia/Shanghai
DB_TYPE=sqlite
DATA_DIR=/var/lib/metapi
# 三项分别使用 openssl rand -hex 32 生成，不共用；加密密钥需长期保留。
AUTH_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
PROXY_TOKEN=REPLACE_WITH_RANDOM_PROXY_TOKEN
ACCOUNT_CREDENTIAL_SECRET=REPLACE_WITH_RANDOM_ENCRYPTION_SECRET
# systemd EnvironmentFile 使用引号保留空格；不要将该文件当作 shell 脚本执行。
CHECKIN_CRON="0 8 * * *"
BALANCE_REFRESH_CRON="0 * * * *"
MODEL_AVAILABILITY_PROBE_ENABLED=false
